# Cursor IDE — not used in this project
.cursor/

# Environment files
.env
.env.local
.env.*.local

# Python bytecode
__pycache__/
*.pyc

# Daily-picks runner local artifacts (home PC)
scripts/.run-daily-picks.log
scripts/.last-run-date
scripts/.last-run-status.json
scripts/.LAST-RUN-FAILED
scripts/.capture-closes.log
scripts/.CAPTURE-FAILED
